{
  "viewport": { "width": 960, "height": 540 },
  "steps": [
    { "page": 0 },
    { "goto": "http://localhost:5187/" },
    { "fill": ["#lobby input >> nth=0", "Alice"] },
    { "fill": ["#lobby input >> nth=1", "ARENA"] },
    { "click": "text=Join" },
    { "waitFor": "button:text-is(\"Ready\")" },
    { "page": 1 },
    { "goto": "http://localhost:5187/?debug=1" },
    { "fill": ["#lobby input >> nth=0", "Bob"] },
    { "fill": ["#lobby input >> nth=1", "ARENA"] },
    { "click": "text=Join" },
    { "waitFor": "button:text-is(\"Ready\")" },
    { "click": "button:text-is(\"Ready\")" },
    { "page": 0 },
    { "click": "button:text-is(\"Ready\")" },

    { "wait": 1500 },
    { "shot": ".shots/arena/countdown.png", "selector": "canvas" },
    { "wait": 1800 },
    { "shot": ".shots/arena/fight-banner.png", "selector": "canvas" },
    { "wait": 1000 },
    { "shot": ".shots/arena/idle.png", "selector": "canvas" },
    { "page": 1 },
    { "shot": ".shots/arena/debug.png", "selector": "canvas" },
    { "eval": "window.__arena.updateMs()" },
    { "page": 0 },

    { "down": "KeyA" },
    { "wait": 2300 },
    { "shot": ".shots/arena/offbounds.png", "selector": "canvas" },
    { "up": "KeyA" },
    { "down": "KeyD" },
    { "wait": 900 },
    { "shot": ".shots/arena/walk.png", "selector": "canvas" },
    { "wait": 800 },
    { "up": "KeyD" },
    { "wait": 200 },

    { "hold": ["KeyW", 80] },
    { "shot": ".shots/arena/jump-ghosts.png", "selector": "canvas" },
    { "wait": 1000 },

    { "hold": ["KeyF", 80] },
    { "shot": ".shots/arena/punch-active.png", "selector": "canvas" },
    { "wait": 400 },
    { "eval": "window.__arena.latest().fighters.map(f => [Math.round(f.x), f.hp])" },

    { "page": 1 },
    { "hold": ["KeyA", 1500] },
    { "down": "KeyS" },
    { "wait": 250 },
    { "page": 0 },
    { "shot": ".shots/arena/block.png", "selector": "canvas" },
    { "hold": ["KeyG", 80] },
    { "wait": 20 },
    { "shot": ".shots/arena/block-hit.png", "selector": "canvas" },
    { "wait": 300 },
    { "page": 1 },
    { "up": "KeyS" },
    { "page": 0 },
    { "wait": 100 },
    { "eval": "window.__arena.latest().fighters.map(f => [Math.round(f.x), f.hp])" },

    { "hold": ["KeyF", 80] },
    { "wait": 30 },
    { "shot": ".shots/arena/hit.png", "selector": "canvas" },
    { "eval": "window.__arena.latest().fighters.map(f => [Math.round(f.x), f.hp])" },
    { "wait": 400 },
    { "hold": ["KeyD", 780] },
    { "hold": ["KeyG", 80] },
    { "wait": 400 },
    { "hold": ["KeyD", 780] },
    { "hold": ["KeyF", 80] },
    { "wait": 400 },
    { "hold": ["KeyD", 780] },
    { "eval": "window.__arena.latest().fighters.map(f => [Math.round(f.x), f.hp])" },
    { "hold": ["KeyG", 80] },
    { "wait": 150 },
    { "shot": ".shots/arena/ko.png", "selector": "canvas" },
    { "eval": "window.__arena.latest().phase" },
    { "wait": 900 },
    { "shot": ".shots/arena/round-banner.png", "selector": "canvas" },

    { "wait": 3600 },
    { "shot": ".shots/arena/car-tunnel.png", "selector": "canvas" },
    { "eval": "window.__arena.latest().trainCar" },
    { "wait": 1500 },
    { "hold": ["KeyD", 1500] },
    { "page": 1 },
    { "hold": ["KeyA", 250] },
    { "hold": ["KeyF", 80] },
    { "shot": ".shots/arena/debug-hitbox.png", "selector": "canvas" },
    { "wait": 400 },
    { "hold": ["KeyA", 780] },
    { "hold": ["KeyG", 80] },
    { "wait": 400 },
    { "hold": ["KeyA", 780] },
    { "hold": ["KeyF", 80] },
    { "wait": 400 },
    { "hold": ["KeyA", 780] },
    { "eval": "window.__arena.latest().fighters.map(f => [Math.round(f.x), f.hp])" },
    { "hold": ["KeyG", 80] },
    { "wait": 150 },
    { "page": 0 },
    { "shot": ".shots/arena/tunnel-ko.png", "selector": "canvas" },
    { "eval": "window.__arena.latest().phase" },

    { "wait": 4500 },
    { "shot": ".shots/arena/car-final.png", "selector": "canvas" },
    { "eval": "window.__arena.latest().trainCar" },
    { "eval": "window.__arena.latest().round" },
    { "eval": "window.__arena.updateMs()" }
  ]
}
