{
  "viewport": { "width": 960, "height": 540 },
  "steps": [
    { "page": 0 },
    { "goto": "http://localhost:5181/?debug=1" },
    { "fill": ["#landing input[name=name]", "Alice"] },
    { "fill": ["#landing input[name=room]", "MOB10"] },
    { "click": "#landing button:text-is(\"Board the train\")" },
    { "waitFor": "#lobby .seats" },
    { "page": 1 },
    { "goto": "http://localhost:5181/" },
    { "fill": ["#landing input[name=name]", "Bob"] },
    { "fill": ["#landing input[name=room]", "MOB10"] },
    { "click": "#landing button:text-is(\"Board the train\")" },
    { "waitFor": "#lobby .seats" },
    { "page": 0 },
    { "click": "#lobby .item[data-item=molotov]" },
    { "wait": 300 },
    { "page": 1 },
    { "waitFor": "button:text-is(\"Ready\")" },
    { "click": "button:text-is(\"Ready\")" },
    { "page": 0 },
    { "waitFor": "button:text-is(\"Ready\")" },
    { "click": "button:text-is(\"Ready\")" },
    { "wait": 4200 },
    { "eval": "window.__arena.drawn().phase" },
    { "eval": "window.__arena.drawn().fighters[0].x" },

    { "hold": ["KeyQ", 60] },
    { "wait": 100 },
    { "eval": "JSON.stringify(window.__arena.drawn().fighters[0].action)" },
    { "down": "KeyD" },
    { "wait": 1000 },
    { "eval": "[window.__arena.drawn().fighters[0].x, window.__arena.drawn().fighters[0].action.kind, window.__arena.drawn().fighters[0].action.elapsed]" },
    { "shot": ".shots/mobile-laser-walk-charge.png", "selector": "canvas" },

    { "hold": ["KeyW", 60] },
    { "wait": 250 },
    { "eval": "[window.__arena.drawn().fighters[0].grounded, window.__arena.drawn().fighters[0].y, window.__arena.drawn().fighters[0].action.kind]" },
    { "shot": ".shots/mobile-laser-jump-charge.png", "selector": "canvas" },
    { "up": "KeyD" },

    { "wait": 2100 },
    { "eval": "[window.__arena.drawn().fighters[0].x, JSON.stringify(window.__arena.drawn().fighters[0].action)]" },
    { "shot": ".shots/mobile-laser-beam.png", "selector": "canvas" },
    { "wait": 600 },
    { "eval": "[window.__arena.drawn().fighters[1].hp, window.__arena.drawn().fighters[0].laserCooldown]" },

    { "wait": 400 },
    { "down": "Digit1" },
    { "wait": 300 },
    { "up": "Digit1" },
    { "eval": "JSON.stringify(window.__arena.drawn().fighters[0].item)" },
    { "down": "KeyF" },
    { "down": "KeyA" },
    { "wait": 500 },
    { "eval": "[window.__arena.drawn().fighters[0].x, JSON.stringify(window.__arena.drawn().fighters[0].action)]" },
    { "shot": ".shots/mobile-throw-walk-charge.png", "selector": "canvas" },
    { "up": "KeyF" },
    { "wait": 300 },
    { "up": "KeyA" },
    { "eval": "[window.__arena.drawn().fighters[0].x, window.__arena.drawn().projectiles.length]" },
    { "shot": ".shots/mobile-throw-released.png", "selector": "canvas" }
  ]
}
